{
  "name": "homelib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "test:nuxt": "vitest run --project nuxt"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "vue-demi",
      "@tailwindcss/oxide"
    ]
  },
  "dependencies": {
    "@nuxt/ui": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "postgres": "^3.4.9",
    "vue": "^3.5.25",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@types/node": "^24.10.1",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.5"
  }
}
