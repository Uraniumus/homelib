# Скопируй в .env и поправь. Файл .env в git не попадает.

# ---------- База ----------
# Локально поднимается через `docker compose up -d postgres`.
DATABASE_URL=postgres://homelib:homelib@localhost:5432/homelib

# Отдельная БД для тестов: их setup дропает схему перед каждым прогоном,
# поэтому она обязана отличаться от рабочей.
TEST_DATABASE_URL=postgres://homelib:homelib@localhost:5433/homelib_test

# ---------- Сессии ----------
# nuxt-auth-utils требует минимум 32 символа.
# Сгенерировать: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# ---------- Объектное хранилище (фото) ----------
# Локально — MinIO из docker-compose. На проде — S3-совместимое хранилище.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=homelib
S3_ACCESS_KEY_ID=homelib
S3_SECRET_ACCESS_KEY=homelib-secret

# ---------- Предохранители ----------
# Жёсткий отказ на файлы больше этого размера (байты).
MAX_UPLOAD_BYTES=10485760
# Сколько фото разрешено на один экземпляр.
PHOTOS_PER_COPY=3
# Лимит книг на бесплатном тарифе.
BOOKS_PER_USER=100

# ---------- Только для прода (docker-compose.prod.yml) ----------
POSTGRES_PASSWORD=
DOMAIN=library.example.com
ACME_EMAIL=you@example.com
